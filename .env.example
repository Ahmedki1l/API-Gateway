# ── SQL Server (shared by System 1) ──────────────────────────────────────────
# DB_DRIVER options:
#   "ODBC Driver 18 for SQL Server"  ← recommended on Windows / containers
#   "ODBC Driver 17 for SQL Server"  ← older Windows / Linux ODBC installs
#   "pymssql"                         ← FreeTDS-based fallback for macOS/Linux dev
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=damanat_pms

# When DB_TRUSTED_CONNECTION=True (Windows Auth), DB_USER and DB_PASSWORD
# are IGNORED — leave them as-is or blank. The connection uses the current
# Windows session's credentials.
DB_USER=sa
DB_PASSWORD=YourStrong!Pass1
DB_TRUSTED_CONNECTION=False

# ── Upstream system base URLs ─────────────────────────────────────────────────
SYSTEM1_BASE_URL=http://localhost:8080          # Damanat-PMS-AI
SYSTEM2_BASE_URL=http://localhost:8000          # Damanat-PMS-VideoAnalytics

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=8001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Camera credentials encryption (REQUIRED) ──────────────────────────────────
# Generate once and keep secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERAS_ENCRYPTION_KEY=

# Internal token for /cameras/{id}/credentials and /cameras/internal/all (REQUIRED).
# Generate once and share with upstream consumers (e.g. VideoAnalytics):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CAMERAS_INTERNAL_TOKEN=

# ── Camera RTSP passwords (used only by scratch/add_cameras.py, NOT the gateway) ──
# One secret per camera, named CAMERA_PW_<camera_id> with the id upper-cased and
# every non-alphanumeric char replaced by '_'. CAMERA_PW_DEFAULT is the fallback
# for any camera without its own key. Keep real values in .env (gitignored).
#   ANPR-Entry -> CAMERA_PW_ANPR_ENTRY ;  Cam_03 -> CAMERA_PW_CAM_03 ;  CAM-15 -> CAMERA_PW_CAM_15
# CAMERA_PW_DEFAULT=
# CAMERA_PW_CAM_01=

# ── Snapshots (PMS-AI shared volume) ──────────────────────────────────────────
# Path inside the gateway container where PMS-AI writes detection JPEGs.
# Mount the same volume PMS-AI writes to (read-only). When the directory
# exists, /snapshots is exposed as a StaticFiles mount and DTO snapshot_url
# values are rewritten from `detection_images/foo.jpg` → `/snapshots/foo.jpg`.
SNAPSHOTS_LOCAL_DIR=/app/detection_images
SNAPSHOTS_PUBLIC_BASE=http://localhost:8001

# ── Camera liveness monitor ───────────────────────────────────────────────────
# Toggle the background TCP poller. Disable for local dev when cameras are unreachable.
#CAMERA_MONITOR_ENABLED=true
#CAMERA_MONITOR_INTERVAL_SECONDS=60
#CAMERA_MONITOR_TCP_TIMEOUT_SECONDS=3.0
#CAMERA_MONITOR_CONCURRENCY=20

# ── Gateway path prefix ───────────────────────────────────────────────────────
# Path prefix inserted between the gateway origin and route paths in externally-
# facing URLs (e.g. embed links).  Set when behind a reverse proxy that routes
# /api/* to the gateway.  Leave empty for no prefix.
# Examples: GATEWAY_PATH_PREFIX=/api  or  GATEWAY_PATH_PREFIX=
GATEWAY_PATH_PREFIX=

# ── Facility timezone (REQUIRED to be explicit; default 3.0 = UTC+3) ─────────
# All "today" / "since-local-midnight" math reads this. Both the Gateway and
# PMS-AI must use the SAME value or per-service "today" windows disagree.
#   Saudi Arabia / Riyadh:        3.0  (no DST)
#   Egypt:                        2.0  (note: DST changes seasonally — review yearly)
#   Cameras report facility-local
#   without a TZ suffix:           0.0 (treat the DB as already-facility-local)
#
# To verify the right value: capture one Hikvision webhook payload and inspect
# its <dateTime> element. If it ends in `Z`, the DB is true UTC and the offset
# should match the facility wall clock. If it has no TZ suffix, the DB is
# facility-local pretending to be UTC and the offset should be 0.0.
FACILITY_TIMEZONE_OFFSET_HOURS=3.0

# ── Reporting window — Report 1 (Occupancy & Utilization) ─────────────────────
#
# Occupancy percentages divide occupied slot-seconds by
# `capacity x counted hours`. With the full 24 hours counted, overnight hours
# sit near 0% and dilute every figure: this deployment reads 22.7% over 24h but
# 43.4% over 07:00-18:00 — same cars, different denominator.
#
# Hours are facility-local. *_TO is EXCLUSIVE, so 7..18 = 07:00:00-17:59:59.
# An excluded hour is dropped from BOTH numerator and denominator — it is a
# not-measured hour, not a 0% hour.
#
# Measured from this deployment (Jul-Aug 2026): arrivals ramp at 07:00, plateau
# ~75% from 11:00-15:00, drained by 18:00. That window holds 87.6% of all
# car-hours parked. Narrowing further flatters the number by discarding real
# parking — 09:00-16:00 reads 55.5% but sees only 71.3% of activity. The API
# returns `parking_captured_pct` on every response so this stays visible.
#
# Set REPORT_BUSINESS_HOURS_ENABLED=false to restore the full-24h convention.
REPORT_BUSINESS_HOURS_ENABLED=true
REPORT_BUSINESS_HOUR_FROM=7
REPORT_BUSINESS_HOUR_TO=18

# Days the facility operates (comma-separated; Mon/Monday/mon all parse).
# Days not listed are dropped from the denominators entirely and their weekday
# bar reports null rather than 0%.
#
# Default is all seven. This site's real operating week is Sun-Thu (Fri/Sat
# average 1.7 and 3.0 sessions vs ~26), and setting it lifts the KPI from 43.4%
# to 55.7% — but the trend chart always renders seven bars, so the headline
# would stop being the average of the bars shown beneath it. Counting all days
# keeps the two reconcilable and shows the weekend as two low bars.
#
#   Operating week only:  REPORT_BUSINESS_DAYS=Sun,Mon,Tue,Wed,Thu
REPORT_BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun
